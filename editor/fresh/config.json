{
  "version": 2,
  "theme": "main.json",
  "check_for_updates": false,
  "editor": {
    "tab_size": 4,
    "line_numbers": true,
    "relative_line_numbers": false,
    "scroll_offset": 5,
    "wrap_column": 100,
    "estimated_line_length": 100,
    "diagnostics_inline_text": true,
    "auto_save_enabled": true,
    "auto_save_interval_secs": 0,
    "mouse_hover_delay_ms": 400,
    "double_click_time_ms": 400,
    "ensure_final_newline_on_save": true,
    "cursor_style": "default",
    "completion_popup_auto_show": true,
    "quick_suggestions_delay_ms": 100,
    "show_menu_bar": false,
    "show_status_bar": true,
    "show_prompt_line": false,
    "show_vertical_scrollbar": false,
    "show_horizontal_scrollbar": false,
    "show_tilde": true,
    "use_terminal_bg": false,
    "whitespace_spaces_leading": false,
    "whitespace_tabs_leading": true,
    "whitespace_tabs_inner": true,
    "whitespace_show": true,
    "cursor_jump_animation": true,
    "whitespace_spaces_trailing": true,
    "line_wrap": false
  },
  "file_explorer": {
    "respect_gitignore": false,
    "show_hidden": true,
    "show_gitignored": true,
    "width": "24%"
  },
  "file_browser": {
    "show_hidden": true
  },



  "keybindings": [
    {
      "key": "r",
      "modifiers": ["alt"],
      "action": "file_explorer_rename",
      "when": "file_explorer"
    },
    {
      "key": "e",
      "modifiers": ["ctrl"],
      "action": "focus_editor",
      "when": "file_explorer"
    },
    {
      "key": "w",
      "modifiers": ["ctrl"],
      "action": "close_tab",
      "when": "normal"
    },
    {
      "key": "k",
      "modifiers": ["alt"],
      "action": "prev_buffer",
      "when": "normal"
    },
    {
      "key": "l",
      "modifiers": ["alt"],
      "action": "next_buffer",
      "when": "normal"
    },
    {
      "key": "i",
      "modifiers": ["alt"],
      "action": "lsp_hover",
      "when": "normal"
    },
    {
      "key": "o",
      "modifiers": ["alt"],
      "action": "close_tab",
      "when": "normal"
    },
    {
      "key": "d",
      "modifiers": ["ctrl", "alt"],
      "action": "duplicate_line",
      "when": "normal"
    },
    {
      "key": "k",
      "modifiers": ["ctrl", "alt"],
      "action": "open_keybinding_editor",
      "when": "normal"
    },
    {
      "key": ",",
      "modifiers": ["alt"],
      "action": "command_palette",
      "when": "normal"
    },
    {
      "key": "k",
      "modifiers": ["ctrl"],
      "action": "cut",
      "when": "normal"
    },
    {
      "key": "x",
      "modifiers": ["ctrl"],
      "action": "Quit",
      "when": "normal"
    },
    {
      "key": "s",
      "modifiers": ["ctrl", "alt"],
      "action": "open_settings",
      "when": "normal"
    },
    {
      "key": "f",
      "modifiers": ["alt"],
      "action": "find_next",
      "when": "normal"
    },
    {
      "key": "g",
      "modifiers": ["alt"],
      "action": "find_prev",
      "when": "normal"
    },
    {
      "key": "Enter",
      "modifiers": ["shift"],
      "action": "insert_newline",
      "when": "normal"
    },
    {
      "key": "f",
      "modifiers": ["ctrl", "alt"],
      "action": "find_selection_next",
      "when": "mode:vi-visual-line"
    },
    {
      "key": "p",
      "modifiers": ["ctrl"],
      "action": "open",
      "when": "normal"
    },
    {
      "key": "/",
      "modifiers": ["alt"],
      "action": "next_split",
      "when": "normal"
    },
    {
      "key": ",",
      "modifiers": ["alt"],
      "action": "quick_open",
      "when": "global"
    },
    {
      "key": "[",
      "modifiers": ["alt"],
      "action": "close_terminal",
      "when": "terminal"
    },
    {
      "key": "/",
      "modifiers": ["ctrl", "alt"],
      "action": "shell_command",
      "when": "normal"
    },
    {
      "key": "d",
      "modifiers": ["alt"],
      "action": "lsp_goto_definition",
      "when": "normal"
    },
    {
      "key": "o",
      "modifiers": ["alt"],
      "action": "close_tab",
      "when": "global"
    }
  ],
  "active_keybinding_map": "vscode",



  "default_language": "markdown",
  "lsp": {
    "c": {
      "enabled": true,
      "auto_start": true,
      "process_limits": {
        "max_memory_percent": 50,
        "max_cpu_percent": 90,
        "enabled": true
      }
    },
    "toml": {
      "enabled": true,
      "auto_start": true,
      "process_limits": {
        "max_memory_percent": 50,
        "max_cpu_percent": 90,
        "enabled": true
      }
    },
    "yaml": {
      "enabled": true,
      "auto_start": true,
      "process_limits": {
        "max_memory_percent": 50,
        "max_cpu_percent": 90,
        "enabled": true
      }
    },
    "cpp": {
      "enabled": true,
      "auto_start": true,
      "root_markers": ["compile_commands.json", "CMakeLists.txt", "Makefile", ".git", "xmake.lua"],
      "process_limits": {
        "max_memory_percent": 50,
        "max_cpu_percent": 90,
        "enabled": true
      }
    },
    "rust": {
      "enabled": true,
      "auto_start": true,
      "process_limits": {
        "max_memory_percent": 50,
        "max_cpu_percent": 90,
        "enabled": true
