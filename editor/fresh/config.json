    "bash": {
      "enabled": true,
      "auto_start": true,
      "process_limits": {
        "max_memory_percent": 50,
        "max_cpu_percent": 90,
        "enabled": true
      }
    },
    "markdown": {
      "enabled": true,
      "auto_start": true,
      "process_limits": {
        "max_memory_percent": 50,
        "max_cpu_percent": 90,
        "enabled": true
      }
    },
    "json": {
      "enabled": true,
      "auto_start": true,
      "process_limits": {
        "max_memory_percent": 50,
        "max_cpu_percent": 90,
        "enabled": true
      }
    },
    "go": {
      "enabled": true,
      "auto_start": true,
      "process_limits": {
        "max_memory_percent": 50,
        "max_cpu_percent": 90,
        "enabled": true
      }
    },
    "lua": {
      "enabled": false,
      "auto_start": true,
      "process_limits": {
        "max_memory_percent": 50,
        "max_cpu_percent": 90,
        "enabled": true
      }
    }
  },
  "universal_lsp": {
    "clangd": {
      "enabled": true,
      "auto_start": true,
      "process_limits": {
        "max_memory_percent": 50,
        "max_cpu_percent": 90,
        "enabled": true
      }
    }
  },
  "plugins": {
    "vi_mode": {
      "enabled": false,
      "settings": {
        "autoStart": false,
        "arrowKeys": true,
        "searchWordUnderCursor": false
      }
    }
  },
  "languages": {
    "go": {
      "auto_indent": true,
      "comment_prefix": "//",
      "extensions": ["go"],
      "format_on_save": false,
      "formatter": {
        "command": "gofmt",
        "args": [],
        "stdin": true,
        "timeout_ms": 10000
      },
      "grammar": "go",
      "show_whitespace_tabs": false,
      "tab_size": 4,
      "use_tabs": false
